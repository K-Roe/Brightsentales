          "globalStart": 42.487,
          "duration": 2.5753333333333335,
          "end": 45.062333333333335
        },
        {
          "key": "speak_3",
          "text": "Bright Speak helps children communicate, using pictures and words to help share what they want to say.",
          "localStart": 9.862,
